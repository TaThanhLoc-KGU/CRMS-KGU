# Copy this file to deploy/.env before running `docker compose up`.
# Never commit the real .env — it holds passwords and secrets.

# ---- PostgreSQL ----
POSTGRES_DB=crms_kgu
POSTGRES_USER=crms
POSTGRES_PASSWORD=change-me-strong-password
# Host port the DB is published on (container always listens on 5432 internally).
# Kept off 5432 by default so it doesn't clash with a native PostgreSQL install.
POSTGRES_HOST_PORT=5433

# ---- Backend (Spring Boot) ----
# Any random 32+ byte string — e.g. `openssl rand -base64 48`. Rotating it logs out all users.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
BACKEND_HOST_PORT=8090

# CORS: origins allowed to call the API (comma-separated). Include both the Vite dev
# server and the host port the dockerized frontend below is published on.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8092

# ---- SMTP (used from P1 onward; safe to leave blank for P0) ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---- Frontend ----
FRONTEND_HOST_PORT=8092

# ---- Gotenberg (Office -> PDF preview conversion, used from P1 onward) ----
GOTENBERG_HOST_PORT=3050
